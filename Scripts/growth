Part A: Daily growth from backup history (run in any database context)
sql
SET NOCOUNT ON;
SET LOCK_TIMEOUT 5000;

DECLARE @DbName sysname = NULL;   -- NULL = all user databases, or set e.g. N'SecretServer'
DECLARE @days   int     = 60;     -- how far back to look

;WITH daily AS (
    SELECT BS.database_name,
           CONVERT(date, BS.backup_start_date) AS backup_day,
           CONVERT(numeric(12,1), MAX(BS.backup_size) / 1048576.0) AS backup_size_mb
    FROM msdb.dbo.backupset BS
    WHERE BS.type = 'D'                                   -- full backups only
      AND BS.database_name NOT IN ('master','msdb','model','tempdb')
      AND (@DbName IS NULL OR BS.database_name = @DbName)
      AND BS.backup_start_date >= DATEADD(DAY, -@days, GETDATE())
    GROUP BY BS.database_name, CONVERT(date, BS.backup_start_date)
),
calc AS (
    SELECT database_name, backup_day, backup_size_mb,
           backup_size_mb - LAG(backup_size_mb) OVER (PARTITION BY database_name ORDER BY backup_day) AS growth_mb,
           DATEDIFF(DAY, LAG(backup_day) OVER (PARTITION BY database_name ORDER BY backup_day), backup_day) AS days_since_prev
    FROM daily
)
SELECT database_name, backup_day, backup_size_mb, growth_mb, days_since_prev,
       CONVERT(numeric(12,1), growth_mb / NULLIF(days_since_prev, 0)) AS avg_growth_mb_per_day
FROM calc
ORDER BY database_name, backup_day;



Part B: Daily snapshot (run inside the Secret Server database)
sql
SET NOCOUNT ON;

SELECT CONVERT(date, GETDATE())                                        AS capture_date,
       @@SERVERNAME                                                    AS server_name,
       DB_NAME()                                                       AS database_name,
       f.name                                                          AS file_name,
       CONVERT(bigint, f.size) * 8 / 1024                              AS allocated_mb,
       CONVERT(bigint, FILEPROPERTY(f.name,'SpaceUsed')) * 8 / 1024    AS used_mb,
       (CONVERT(bigint, f.size) - FILEPROPERTY(f.name,'SpaceUsed')) * 8 / 1024 AS free_in_file_mb,
       vs.volume_mount_point                                           AS drive,
       CONVERT(bigint, vs.available_bytes) / 1048576                   AS disk_free_mb
FROM sys.database_files f
CROSS APPLY sys.dm_os_volume_stats(DB_ID(), f.file_id) vs
WHERE f.type_desc = 'ROWS';

to see all
SET NOCOUNT ON;

SELECT CONVERT(date, GETDATE())                    AS capture_date,
       @@SERVERNAME                                AS server_name,
       DB_NAME(f.database_id)                      AS database_name,
       f.name                                      AS file_name,
       CONVERT(bigint, f.size) * 8 / 1024          AS allocated_mb,
       vs.volume_mount_point                       AS drive,
       CONVERT(bigint, vs.available_bytes) / 1048576 AS disk_free_mb
FROM sys.master_files f
CROSS APPLY sys.dm_os_volume_stats(f.database_id, f.file_id) vs
WHERE f.type_desc = 'ROWS'
  AND f.database_id > 4          -- skip system databases
ORDER BY allocated_mb DESC;

for table size:

SET NOCOUNT ON;
SET LOCK_TIMEOUT 5000;

SELECT CONVERT(date, GETDATE())                         AS capture_date,
       @@SERVERNAME                                     AS server_name,
       DB_NAME()                                        AS database_name,
       s.name + '.' + t.name                            AS table_name,
       SUM(CASE WHEN ps.index_id < 2 THEN ps.row_count ELSE 0 END) AS row_count,
       SUM(ps.used_page_count) * 8 / 1024               AS total_used_mb,
       SUM(CASE WHEN ps.index_id < 2 THEN ps.used_page_count ELSE 0 END) * 8 / 1024 AS data_mb,
       SUM(CASE WHEN ps.index_id >= 2 THEN ps.used_page_count ELSE 0 END) * 8 / 1024 AS index_mb,
       SUM(ps.lob_used_page_count) * 8 / 1024           AS lob_mb
FROM sys.dm_db_partition_stats ps
JOIN sys.tables t  ON t.object_id = ps.object_id
JOIN sys.schemas s ON s.schema_id = t.schema_id
GROUP BY s.name, t.name
HAVING SUM(ps.used_page_count) * 8 / 1024 >= 100      -- only tables of 100 MB or more
ORDER BY total_used_mb DESC;

Run this query to find out exactly which day and hour the rows are flooding into this table:
sql
SELECT 
    CAST(CreatedDate AS DATE) AS DiscoveredDate,
    DATEPART(HOUR, CreatedDate) AS DiscoveredHour,
    COUNT(*) AS RowsInserted
FROM 
    tbProxySessionDataHash
WHERE 
    CreatedDate >= DATEADD(day, -7, GETDATE()) -- Checks the last week
GROUP BY 
    CAST(CreatedDate AS DATE),
    DATEPART(HOUR, CreatedDate)
ORDER BY 
    RowsInserted DESC;

tbProxySessionDataHash links back to the actual connection logs. Join it with the main proxy session tables to see who logged in, what asset they connected to, and when it happened over the weekend:
sql
SELECT TOP 50
    h.CreatedDate,
    p.ProxySessionId,
    p.UserName,
    p.SecretName,
    p.HostName,
    p.StartTime,
    p.EndTime
FROM 
    tbProxySessionDataHash h
-- Adjust table joins based on Delinea schema (commonly tbProxySession or tbSecretProxySession)
INNER JOIN 
    tbProxySession p ON h.ProxySessionId = p.ProxySessionId 
WHERE 
    h.CreatedDate >= '2026-10-23' -- Put last Friday's date here
ORDER BY 
    h.ProxySessionId DESC;


DECLARE @maxid BIGINT;
SELECT @maxid = MAX(ProxySessionDataHashId) FROM dbo.tbProxySessionDataHash WITH (NOLOCK);

SELECT TOP (25) h.ProxySessionDataId, COUNT(*) AS hash_rows
FROM dbo.tbProxySessionDataHash h WITH (NOLOCK)
WHERE h.ProxySessionDataHashId > @maxid - 5000000
GROUP BY h.ProxySessionDataId
ORDER BY hash_rows DESC
OPTION (MAXDOP 1);

SET NOCOUNT ON;
SELECT o.name AS table_name, c.name AS column_name, ty.name AS type_name,
       c.max_length, c.is_identity
FROM sys.columns c
JOIN sys.objects o ON o.object_id = c.object_id
JOIN sys.types ty  ON ty.user_type_id = c.user_type_id
WHERE o.name IN ('tbProxySessionDataHash','tbProxySessionData')
ORDER BY o.name, c.column_id;

-- Which indexes exist and on which columns (so we know which lookups are cheap)
SELECT OBJECT_NAME(i.object_id) AS table_name, i.name AS index_name, i.type_desc,
       i.is_primary_key,
       STUFF((SELECT ', ' + c.name
              FROM sys.index_columns ic
              JOIN sys.columns c ON c.object_id = ic.object_id AND c.column_id = ic.column_id
              WHERE ic.object_id = i.object_id AND ic.index_id = i.index_id AND ic.is_included_column = 0
              ORDER BY ic.key_ordinal FOR XML PATH('')), 1, 2, '') AS key_columns
FROM sys.indexes i
WHERE i.object_id IN (OBJECT_ID('dbo.tbProxySessionDataHash'), OBJECT_ID('dbo.tbProxySessionData'))
  AND i.index_id > 0;
